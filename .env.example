# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. ENVIRONMENT MODE
NODE_ENV=development
PORT=3000
